<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F2F5FA">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center"
                android:text="@string/app_name" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/black" android:gravity="center" />
        </FrameLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2">
            <ImageView android:id="@+id/imageForLoaded" android:layout_width="180dp" android:layout_height="180dp" android:layout_gravity="center"
                android:src="@drawable/ic_app_logo" android:contentDescription="@string/loading_logo" />
        </FrameLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/LoadingStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/loading_users" android:textSize="16sp" android:textColor="@color/muted" android:gravity="center" />
                <Button android:id="@+id/RetryButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="12dp"
                    android:text="@string/retry" android:textAllCaps="false" android:onClick="Retry" android:visibility="gone" />
                <Button android:id="@+id/LoadingBackButton" android:layout_width="wrap_content" android:layout_height="48dp"
                    android:text="@string/back_to_signin" android:textAllCaps="false" android:onClick="Back" android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
